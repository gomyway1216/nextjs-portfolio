  "objective": "Repair a reproduced production 30-bit position-hash collision with an independent secondary lock, prove correctness and bounded performance, then measure direct-play non-regression without changing the live NNUE weights.",
  "claim_boundary": {
    "known_fact": "In an isolated private-TT experiment, two distinct legal positions with primary hash 218180606 cause the production WASM search core to reuse a stale illegal move key; the browser host is expected to reject that key and fall back.",
    "candidate": "Keep the production primary hash unchanged and require an independent full-width secondary lock for the research private transposition table, evaluation cache, and search-path repetition identity.",
    "not_claimed": [
      "This repair is guaranteed to increase Elo or reach high-dan strength.",
      "The collision frequency in ordinary live games is known.",
      "A pass at the 82/192 non-regression floor proves that the candidate is stronger.",
      "This research plan changes any shipped runtime, JavaScript fallback, shared transposition table, opening cache, mate solver, or live NNUE weight."
    ]
  },
