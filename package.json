    "shogi:floodgate-v7-checkpoint-scan-load": "node --expose-gc -r tsx/cjs ml/floodgate-v7-checkpoint-scan-load.ts",
    "shogi:floodgate-v7-key-provision": "node -r tsx/cjs ml/provision-floodgate-v7-deployment-key.ts",
