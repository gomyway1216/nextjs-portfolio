    "shogi:floodgate-v7-key-enrollment-binding-preflight": "/usr/bin/osascript -l JavaScript \"$(/bin/pwd -P)/ml/helpers/floodgate-v7-production-native-launcher.jxa\" approved-current-binding-readiness",
    "shogi:floodgate-v7-offline-connector-gates": "node -r tsx/cjs ml/run-floodgate-v7-offline-connector-gates.ts",
    "shogi:floodgate-v7-production-connector-registry-provision": "/usr/bin/osascript -l JavaScript \"$(/bin/pwd -P)/ml/helpers/floodgate-v7-production-native-launcher.jxa\" production-registry-provision",
    "shogi:floodgate-v7-production-application-source-readiness": "/usr/bin/osascript -l JavaScript \"$(/bin/pwd -P)/ml/helpers/floodgate-v7-production-native-launcher.jxa\" application-source-readiness",
    "shogi:floodgate-v7-production-connector-verifier-readiness": "/usr/bin/osascript -l JavaScript \"$(/bin/pwd -P)/ml/helpers/floodgate-v7-production-native-launcher.jxa\" connector-verifier-readiness",
    "shogi:floodgate-v7-production-prefix-100-preflight": "/usr/bin/osascript -l JavaScript \"$(/bin/pwd -P)/ml/helpers/floodgate-v7-production-native-launcher.jxa\" prefix-100-read-only-preflight",
    "shogi:floodgate-v7-production-prefix-100-kill-drill": "/usr/bin/osascript -l JavaScript \"$(/bin/pwd -P)/ml/helpers/floodgate-v7-production-native-launcher.jxa\" prefix-100-disposable-kill-drill",
    "shogi:floodgate-v7-production-connector-prefix-100": "/usr/bin/osascript -l JavaScript \"$(/bin/pwd -P)/ml/helpers/floodgate-v7-production-native-launcher.jxa\" durable-prefix-100",
