    "shogi:floodgate-v7-production-connector-final-24000": "/usr/bin/osascript -l JavaScript \"$(/bin/pwd -P)/ml/helpers/floodgate-v7-production-native-launcher.jxa\" sealed-final-24000",
    "shogi:floodgate-v7-training-label-production": "/usr/bin/osascript -l JavaScript \"$(/bin/pwd -P)/ml/helpers/floodgate-v7-production-native-launcher.jxa\" training-label-finalization-24000",
    "shogi:floodgate-v7-local-clean-room-teacher": "node -r tsx/cjs ml/run-floodgate-v7-local-clean-room-teacher.ts",
    "shogi:floodgate-v7-local-clean-room-training-label-finalizer": "node -r tsx/cjs ml/run-floodgate-v7-local-clean-room-training-label-finalizer.ts",
    "shogi:halfkp81-depth18-teacher": "node -r tsx/cjs ml/run-halfkp81-depth18-teacher.ts",
