{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "middleware.ts",
    "next.config.ts",
    "playwright.config.ts",
    "vitest.config.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // tests/unit/ml pulls the standalone ml/ tooling (116 TS files) into the
  // program; keeping it out of the app project keeps `next build` typechecks
  // scoped to code that actually ships. ml/ and scripts/ run via tsx and have
  // their own configs (tsconfig.seed.json for scripts/).
  "exclude": ["node_modules", "tests/unit/ml/**", "ml/**", "scripts/**", "wasm-spike/**", "native/**", "docs/**"]
}
