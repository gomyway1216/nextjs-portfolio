+/** Strict stable-order comparator: score descending, generation ordinal ascending. */
+function researchHeapHigher(base: i32, a: i32, b: i32): bool {
+  const scoreA = unchecked(moveScoreBuf[base + a]);
+  const scoreB = unchecked(moveScoreBuf[base + b]);
+  if (scoreA != scoreB) return scoreA > scoreB;
+  return unchecked(researchHeapOrdinalBuf[base + a]) <
+    unchecked(researchHeapOrdinalBuf[base + b]);
+}
+
+function researchHeapSwap(base: i32, a: i32, b: i32): void {
+  const move = unchecked(moveBuf[base + a]);
+  const score = unchecked(moveScoreBuf[base + a]);
+  const ordinal = unchecked(researchHeapOrdinalBuf[base + a]);
+  unchecked(moveBuf[base + a] = moveBuf[base + b]);
+  unchecked(moveScoreBuf[base + a] = moveScoreBuf[base + b]);
+  unchecked(researchHeapOrdinalBuf[base + a] = researchHeapOrdinalBuf[base + b]);
+  unchecked(moveBuf[base + b] = move);
+  unchecked(moveScoreBuf[base + b] = score);
+  unchecked(researchHeapOrdinalBuf[base + b] = ordinal);
+}
+
+function researchHeapSiftDown(base: i32, root: i32, size: i32): void {
+  let current = root;
+  while (true) {
+    const left = current * 2 + 1;
+    if (left >= size) return;
+    const right = left + 1;
+    let best = left;
+    if (right < size && researchHeapHigher(base, right, left)) best = right;
+    if (!researchHeapHigher(base, best, current)) return;
+    researchHeapSwap(base, current, best);
+    current = best;
+  }
+}
+
+function researchHeapBuild(ply: i32, n: i32): void {
+  const base = ply * MAX_MOVES;
+  for (let i = 0; i < n; i++) unchecked(researchHeapOrdinalBuf[base + i] = i);
+  for (let i = (n >> 1) - 1; i >= 0; i--) researchHeapSiftDown(base, i, n);
+}
+
+/** Pop the next move in exactly insertionSortDesc's stable order. */
+function researchHeapPopMove(ply: i32, size: i32): i32 {
+  const base = ply * MAX_MOVES;
+  const move = unchecked(moveBuf[base]);
+  const last = size - 1;
+  if (last > 0) {
+    unchecked(moveBuf[base] = moveBuf[base + last]);
+    unchecked(moveScoreBuf[base] = moveScoreBuf[base + last]);
+    unchecked(researchHeapOrdinalBuf[base] = researchHeapOrdinalBuf[base + last]);
+    researchHeapSiftDown(base, 0, last);
+  }
+  return move;
+}
