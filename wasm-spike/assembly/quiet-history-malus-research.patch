+
+/** Pure probe used by the research unit test to exhaust the update boundary. */
+export function researchQuietHistoryUpdateProbe(current: i32, rawBonus: i32): i32 {
+  const h = maxI(-RESEARCH_QUIET_HISTORY_MAX, minI(RESEARCH_QUIET_HISTORY_MAX, current));
+  const bonus =
+    maxI(-RESEARCH_QUIET_HISTORY_MAX, minI(RESEARCH_QUIET_HISTORY_MAX, rawBonus));
+  const magnitude = absI(bonus);
+  const damping = <i32>(
+    (<i64>h * <i64>magnitude) / <i64>RESEARCH_QUIET_HISTORY_MAX
+  );
+  return maxI(
+    -RESEARCH_QUIET_HISTORY_MAX,
+    minI(RESEARCH_QUIET_HISTORY_MAX, h + bonus - damping),
+  );
+}
+
+function researchQuietHistoryUpdate(
+  table: StaticArray<i32>,
+  idx: i32,
+  rawBonus: i32,
+  continuation: bool,
+  strictQuiet: bool,
+): void {
+  if (!strictQuiet) {
+    researchQuietNonQuietUpdateViolations++;
+    return;
+  }
+  const next = researchQuietHistoryUpdateProbe(unchecked(table[idx]), rawBonus);
+  unchecked(table[idx] = next);
+  const magnitude = absI(next);
+  if (continuation) {
+    researchQuietContinuationUpdates++;
+    researchQuietMaxAbsContinuation =
+      maxI(researchQuietMaxAbsContinuation, magnitude);
+  } else {
+    researchQuietMainUpdates++;
+    researchQuietMaxAbsMain = maxI(researchQuietMaxAbsMain, magnitude);
+  }
+}
+
+function researchQuietReward(depthLeft: i32): i32 {
+  const d = maxI(1, minI(32, depthLeft));
+  return minI(2_048, 16 * d * d);
+}
+
+function researchQuietMalus(depthLeft: i32): i32 {
+  const d = maxI(1, minI(32, depthLeft));
+  return -minI(1_024, 8 * d * d);
+}
 
